# FILE LOCATION: quantai/apps/api/.env.example
# Copy this file to quantai/apps/api/.env and fill in real values.

PORT=4000
DATABASE_URL="postgresql://quantai:quantai_dev_password@localhost:5432/quantai?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AI_SERVICE_URL="http://localhost:8000"
